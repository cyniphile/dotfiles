        "key": "cmd+h",
        "command": "workbench.action.navigateLeft",
        "when": "isMac && !auxiliaryBarFocus"
    },
    {
        // Leave right sidebar (Auxiliary Bar) to editor
        "key": "cmd+h",
        "command": "workbench.action.focusActiveEditorGroup",
        "when": "auxiliaryBarFocus && isMac"
    },


        {
    //    focused not working 
        "key": "cmd+h",
        "command": "workbench.action.focusActiveEditorGroup",
        "when": "auxiliaryBarVisible && chatgpt.sidebarView.active"
        },

    {
        "key": "cmd+l",
        "command": "workbench.action.navigateRight",
        "when": "isMac"
    },
    {
        "key": "cmd+k",
        "command": "workbench.action.navigateUp",
        "when": "isMac"
