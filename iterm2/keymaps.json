{
    "profiles": ["Hotkey"],
    "chords": [
        {"chord": "Cmd+Opt+C",       "nvim": "<D-M-c>", "does": "yank the file's full path (VS Code copyFilePath)"},
        {"chord": "Cmd+Opt+Shift+C", "nvim": "<D-M-C>", "does": "yank the path relative to the project root"},
        {"chord": "Cmd+S",           "nvim": "<D-s>",   "does": "write the buffer"},
        {"chord": "Cmd+F",           "nvim": "<D-f>",   "does": "search the buffer"},
        {"chord": "Cmd+Shift+F",     "nvim": "<D-F>",   "does": "search the tree with Ack"}
    ]
}
