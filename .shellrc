HISTCONTROL=ignoreboth:erasedups


[[ $- == *i* ]] && stty intr ^n

if [ -n "$COLUMNS" ] && [ "$COLUMNS" -ge 100 ]; then
    fortune -s | hsterminal
fi

# Alias definitions.
if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi

# fixes mac forking problems: 
# https://blog.phusion.nl/2017/10/13/why-ruby-app-servers-break-on-macos-high-sierra-and-what-can-be-done-about-it/
export OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES 

# Two fd passes: shallow files (depth <= 4) stream into fzf first, the deep
# remainder appends after. Paired with --scheme=history below (match quality
# only, ties broken by input order), searching a project name ranks its
# root-level files above 9-level-deep copies in docs/vendored trees, which
# fzf's default scheme scored higher whenever the query hit the start of a
# path component.
#
# Hidden files are held back for a second list. A few are worth finding
# (.zshrc, .gitconfig, .github/), but the caches and state dirs around them
# outnumber those by far: even with .fdignore pruning the worst trees,
# --hidden added ~2300 paths to the shallow pass in ~ and took twice as long.
# So the default list leaves them out and fzf_capped_hidden puts them back,
# on Cmd+Shift+P. .fdignore applies to both.
_fzf_fd='--type file --follow --exclude .git'
export FZF_DEFAULT_COMMAND="fd $_fzf_fd --max-depth 4; fd $_fzf_fd --min-depth 5"
export FZF_HIDDEN_COMMAND="fd --hidden $_fzf_fd --max-depth 4; fd --hidden $_fzf_fd --min-depth 5"
unset _fzf_fd
export FZF_DEFAULT_OPTS='--bind=tab:down,btab:up --cycle --scheme=history'

# fzf has no per-query cap on matches, so a loose query ("s") matches thousands
# of paths and --cycle wraps Tab into that low-scoring tail. This wrapper holds
# the list to one screenful: FZF_DEFAULT_COMMAND runs once and is tee'd to a
# snapshot, an external `fzf --filter` does the matching on each keystroke, and
# fzf itself runs with its own matcher off (--disabled). The inner fzf inherits
# FZF_DEFAULT_OPTS, so --scheme=history ranking is unchanged — only the tail
# below the fold is cut. Trade-off: --disabled means no matched-char highlight.
#
# $1 is the command that lists the files, so the same picker serves the
# hidden-free default and FZF_HIDDEN_COMMAND.
fzf_capped() {
    local cache rows src
    src="${1:-$FZF_DEFAULT_COMMAND}"
    cache="${TMPDIR:-/tmp}/fzf-capped.$$"  # one per shell, overwritten per call
    : > "$cache"

    rows="${LINES:-0}"
    [ "$rows" -lt 1 ] && rows=$(tput lines 2>/dev/null || echo 40)
    rows=$(( rows - 3 ))               # leave room for prompt + counter
    [ "$rows" -lt 10 ] && rows=10

    # start: stream the two fd passes straight into the list exactly as before
    # (tee snapshots them for the filter below, so the first paint is not
    # blocked on the deep pass finishing). </dev/null stops fzf from also
    # running FZF_DEFAULT_COMMAND itself, which would scan twice.
    fzf-tmux --disabled \
        --bind "start:reload:{ $src ; } | tee '$cache'" \
        --bind "change:reload:fzf --filter={q} < '$cache' | head -n $rows" \
        < /dev/null

    rm -f "$cache"
}

# The same picker over the hidden files as well. Bound to Cmd+Shift+P, beside
# Cmd+P's hidden-free list; .fdignore still keeps the cache trees out.
fzf_capped_hidden() {
    fzf_capped "$FZF_HIDDEN_COMMAND"
}

function join () {
    echo "$*"
}

function quick_grep() {
   args=$(echo "$*")
   if [ "$args" = "" ]
   then
      return 1
   fi
   vi -c "Ack!'$args'"
}

# open fuzzy finder, search for files, use default program to open 
# and cd to dir of file
function smart_open() {
    args="$*"
    if [ -z "$args" ]; then
        return 1
    fi

    # Resolve to absolute path
    file_path=$(realpath "$args" 2>/dev/null)
    if [ ! -e "$file_path" ]; then
        echo "File not found: $args"
        return 1
    fi

    # Get directory of the file and cd there
    file_dir=$(dirname "$file_path")
    cd "$file_dir" || return 1

    # Text and markup stay in the editor whatever `file` reports, since it
    # sniffs bytes rather than names. Everything else goes to the default app:
    # Launch Services routes on extension/UTI, not content, so it places files
    # the sniffer gave up on (.prism -> Prism, .fcs -> its analyzer). Two
    # exceptions: `open` would *launch* an executable, and it exits 1 when no
    # app is registered — fall back to the editor instead of doing nothing.
    # (This was an xdg-mime/xdg-open test, which no macOS box has, so it errored
    # and fell through to vi for every file type.)
    # head -1: universal binaries report one line per architecture, and a
    # multi-line value would match nothing and fall through to `open`, which
    # runs executables.
    file_mime=$(file --mime-type -b "$file_path" 2>/dev/null | head -1)
    case "$file_mime" in
        text/*|inode/x-empty|image/svg+xml|\
        application/json|application/xml|application/javascript)
            vi "$file_path" ;;
        application/x-mach-binary|application/x-executable|application/x-sharedlib)
            vi "$file_path" ;;
        *)
            open "$file_path" >/dev/null 2>&1 || vi "$file_path" ;;
    esac
}



# cd to the dir of the selected file and browse it in yazi;
# shell follows yazi's cwd when it exits (quit with Q to keep the original dir)
function smart_cd() {
   args=$(echo "$*")
   if [ -z "$args" ]; then
      return 1
   fi
   local target dir tmp cwd
   target=$(realpath "$args" 2>/dev/null) || target="$args"
   dir=$(dirname "$target") && cd "$dir" || return 1
   command -v yazi >/dev/null 2>&1 || return 0
   tmp=$(mktemp -t yazi-cwd.XXXXXX)
   yazi "$target" --cwd-file="$tmp"
   cwd=$(cat -- "$tmp" 2>/dev/null)
   if [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
      cd -- "$cwd"
   fi
   rm -f -- "$tmp"
}

# Fuzzy-pick a Project Manager project and open it in VS Code.
# For the case the keybinding cannot cover: no VS Code window is open yet, so
# there is no warm window to launch from. Handing the folder to the CLI skips
# the empty window entirely, so the extension host never has to load before the
# project is chosen.
# The list comes from Project Manager's own store, so it stays identical to the
# in-editor picker with no second list to keep in sync.
# `code <folder>` rather than `code -n`: it still gets a new window (the default
# for window.openFoldersInNewWindow), but it focuses the project's window when
# one is already open instead of making a duplicate.
function proj() {
    local store choice
    store="$HOME/Library/Application Support/Code/User/globalStorage/alefragnani.project-manager/projects.json"
    if [ ! -f "$store" ]; then
        echo "no Project Manager store at $store"
        return 1
    fi
    # Kept tab-delimited rather than run through `column`: the path is taken as
    # everything after the tab, so a project path with a space in it survives.
    choice=$(jq -r '.[] | select(.enabled != false) | "\(.name)\t\(.rootPath)"' "$store" \
        | fzf --height 40% --reverse --delimiter=$'\t' --nth=1,2 \
              --query "$*" --select-1 --exit-0) || return 1
    [ -n "$choice" ] || return 1
    code -- "${choice#*$'\t'}"
}

# Generate a password. The bytes come from /dev/urandom, the kernel CSPRNG, so
# the result does not depend on $RANDOM, the clock or the pid — $RANDOM is
# seeded per shell and the other two are guessable after the fact.
#
# `tr -dc` is rejection sampling, not a modulo fold: a byte outside the
# alphabet is dropped rather than wrapped back into it, so every character
# stays equally likely. `$RANDOM % 62`, `awk rand()` and `sort -R` all lean on
# the low end of the alphabet, and only the first of the three looks wrong.
#
# Nothing is installed for this and nothing leaves the machine: tr, head and
# /dev/urandom are on every macOS and Linux box.
#
# The secret goes to the clipboard, not to the screen, so it does not sit in
# the scrollback of a terminal that stays open all day.
#
#   random              10 chars of A-Za-z0-9 (~59 bits), copied
#   random 24 -s        24 chars, punctuation included
#   random -n 5 -u      5 secrets, no 0/O/1/l/I look-alikes
#   random -d -l 6      a 6-digit PIN
#   random -x -l 32     32 hex chars, i.e. a 128-bit key
#   random -p           printed instead, when you must read it off the screen
#   pw=$(random)        captured — stdout is a pipe, so it prints
random() {
    local len=10 count=1 mode='' sym='' unambig='' dest='' bits=''
    local alphabet pw out i

    while [ $# -gt 0 ]; do
        case "$1" in
            -l|--length)
                [ -n "$2" ] || { printf 'random: %s needs a number\n' "$1" >&2; return 2; }
                len=$2; shift 2 ;;
            -n|--count)
                [ -n "$2" ] || { printf 'random: %s needs a number\n' "$1" >&2; return 2; }
                count=$2; shift 2 ;;
            -s|--symbols)     sym=1;       shift ;;
            -u|--unambiguous) unambig=1;   shift ;;
            -d|--digits)      mode=digits; shift ;;
            -x|--hex)         mode=hex;    shift ;;
            -c|--copy)        dest=copy;   shift ;;
            -p|--print)       dest=print;  shift ;;
            -b|--bits)        bits=1;      shift ;;
            [0-9]*)           len=$1;      shift ;;
            -h|--help)
                cat <<'USAGE'
random — a secret from /dev/urandom. No network, no dependencies.

usage: random [LENGTH] [options]

  -l, --length N       characters per secret (default 10)
  -n, --count N        how many to make (default 1)
  -s, --symbols        add punctuation to the letters and digits
  -u, --unambiguous    drop the look-alikes 0 O 1 l I
  -d, --digits         digits only, for a PIN
  -x, --hex            lowercase hex, for a key
  -p, --print          print it instead of copying it
  -c, --copy           copy it even when stdout is a pipe
  -b, --bits           report the entropy on stderr
  -h, --help           this text

The secret is copied to the clipboard and not printed, so it stays out of the
scrollback. It is printed instead when stdout is not a terminal, so that
`pw=$(random)` and `random | ...` still work.

-s and -u shape the default alphabet only. They do not apply to -d or -x.
USAGE
                return 0 ;;
            *)
                printf 'random: unknown option %s (try --help)\n' "$1" >&2
                return 2 ;;
        esac
    done

    # `,*` and `*,` catch an empty length or count, which `*[!0-9,]*` cannot.
    case "$len,$count" in
        *[!0-9,]*|,*|*,) printf 'random: --length and --count take whole numbers\n' >&2; return 2 ;;
    esac
    if [ "$len" -lt 1 ] || [ "$count" -lt 1 ]; then
        printf 'random: --length and --count must be at least 1\n' >&2
        return 2
    fi
    if [ -n "$mode" ] && [ -n "$sym$unambig" ]; then
        printf 'random: -s and -u shape the default alphabet, not -d/-x\n' >&2
        return 2
    fi
    # An explicit -c that cannot copy has to fail rather than fall back to the
    # screen, which is the one place the flag was asked to keep it away from.
    if [ "$dest" = copy ] && ! command -v pbcopy >/dev/null 2>&1; then
        printf 'random: -c needs pbcopy, which is not on this PATH\n' >&2
        return 1
    fi
    if [ -z "$dest" ]; then
        # Copy unless stdout is not a terminal: `pw=$(random)` and a pipe both
        # need the text, and neither leaves anything in the scrollback anyway.
        if [ -t 1 ] && command -v pbcopy >/dev/null 2>&1; then dest=copy; else dest=print; fi
    fi

    case "$mode" in
        digits) alphabet=0123456789 ;;
        hex)    alphabet=0123456789abcdef ;;
        *)      alphabet=ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789
                # The pairs a person retypes wrong off a screen or a sticky note.
                [ -n "$unambig" ] && alphabet=$(printf '%s' "$alphabet" | LC_ALL=C tr -d '0O1lI')
                # No quote, backslash or backtick: those are the characters that
                # break when a password is pasted into a shell command, a CSV
                # field or a YAML value. `-` goes last because tr reads it as a
                # range anywhere else.
                [ -n "$sym" ] && alphabet="$alphabet"'!#$%&()*+,./:;<=>?@[]^_{|}~-' ;;
    esac

    i=1
    out=''
    while [ "$i" -le "$count" ]; do
        # head closes the pipe at $len bytes and tr dies of SIGPIPE, which is
        # the intended stop; 2>/dev/null keeps that off the terminal.
        pw=$({ LC_ALL=C tr -dc "$alphabet" < /dev/urandom | head -c "$len"; } 2>/dev/null)
        out="${out:+$out
}$pw"
        i=$((i + 1))
    done

    if [ -n "$bits" ]; then
        awk -v n="${#alphabet}" -v l="$len" 'BEGIN {
            printf "random: %d chars from %d symbols = %.1f bits each\n", l, n, l * log(n) / log(2)
        }' >&2
    fi

    if [ "$dest" = copy ]; then
        # No trailing newline: a password pasted into a browser field should not
        # also submit the form.
        printf '%s' "$out" | pbcopy
        printf 'random: %s x %s chars copied\n' "$count" "$len" >&2
    else
        printf '%s\n' "$out"
    fi
}

export NVIM_TUI_ENABLE_CURSOR_SHAPE=1

PATH="/usr/local/bin/ctags:$PATH"
export PATH

